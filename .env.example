DATABASE_URL="postgresql://rental:rental@localhost:5433/rental?schema=public"
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental

# Used only by the seed script to create the first admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Auth.js session signing key (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me
# Fixed RON per 1 EUR used to show/charge prices in EUR
EUR_RON_RATE=5.0

# Integration tests ONLY: must be a local database whose name ends with _test (created automatically)
TEST_DATABASE_URL="postgresql://rental:rental@localhost:5433/rental_test?schema=public"

# Where uploaded vehicle photos are stored (a Docker volume in docker-compose)
UPLOAD_DIR=./uploads
